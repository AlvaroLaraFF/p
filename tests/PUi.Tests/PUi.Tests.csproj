<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the PUi logic (focus, navigation, player state machine, screens over doubles). Uses the net8.0 build of PUi (SkiaSharp 2.88). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>PUi.Tests</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CS0612;xUnit2029</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <ProjectReference Include="..\..\src\AceEngine\AceEngine.csproj" />
    <ProjectReference Include="..\..\src\AceEngine.Sim\AceEngine.Sim.csproj" />
    <ProjectReference Include="..\..\src\PUi\PUi.csproj" />
    <ProjectReference Include="..\..\src\PUi.Demo\PUi.Demo.csproj" />
    <ProjectReference Include="..\..\src\PUi.Testing\PUi.Testing.csproj" />
    <!-- a pure table of the TV shell (no Tizen API): linked, not referenced, so it can be tested here -->
    <Compile Include="..\..\src\PTizen\Platform\TizenKeys.cs" LinkBase="Linked" />
    <None Include="..\..\src\PUi\fonts\*.ttf" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\PUi\images\*.png" Link="images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
