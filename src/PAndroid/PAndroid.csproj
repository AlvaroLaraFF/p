<Project Sdk="Microsoft.NET.Sdk">
  <!--
    P! for Android: ONE apk for Android TV / Google TV, Fire TV (Fire OS) and phones and tablets with a touch interface (landscape). The interface is PUi (the net8.0 build,
    SkiaSharp 2.88), drawn by AndroidSkiaView (TextureView + EGL on the main thread) over a video SurfaceView; the engine is AceEngine as is; the player is Media3/ExoPlayer.
    The differences between devices come from a profile detected at startup (AndroidDeviceProfile), not from separate builds.
    Not part of P.sln: it needs the android workload, the Android SDK and a JDK 17 (see the README). .NET 10 (global.json in this folder); the rest of the repository uses .NET 8.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- minSdk 25 (Fire OS 6; Media3 itself needs 23). targetSdk 35 is in AndroidManifest.xml (see the comment there). -->
    <SupportedOSPlatformVersion>25</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>PAndroid</RootNamespace>
    <AssemblyName>PAndroid</AssemblyName>
    <ApplicationId>org.p.app</ApplicationId>
    <ApplicationTitle>P!</ApplicationTitle>
    <ApplicationVersion>$(AppVersionCode)</ApplicationVersion>
    <ApplicationDisplayVersion>$(AppVersion)</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <!-- deploy-android.sh with its ABI option builds for one ABI only (smaller, faster): -p:PAndroidRids=android-arm64 (not -p:RuntimeIdentifiers, which would reach the referenced projects too) -->
    <RuntimeIdentifiers Condition="'$(PAndroidRids)' != ''">$(PAndroidRids)</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The app talks through .NET sockets, not through the Java HTTP stack. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0612;CA1416;CA1422;XA4211;XA1006</NoWarn>
  </PropertyGroup>

  <!-- Stable development signing key, OUTSIDE the repository (the same one for Debug and Release, so `adb install -r` updates in place). -->
  <PropertyGroup>
    <PAndroidKeysDir Condition="'$(PAndroidKeysDir)' == '' And '$(P_ANDROID_KEYS)' != ''">$(P_ANDROID_KEYS)</PAndroidKeysDir>
    <PAndroidKeysDir Condition="'$(PAndroidKeysDir)' == ''">$(MSBuildThisFileDirectory)../../../p-interno/android-keys</PAndroidKeysDir>
  </PropertyGroup>
  <Import Project="$(PAndroidKeysDir)/signing.props" Condition="Exists('$(PAndroidKeysDir)/signing.props')" />

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Smaller apk (only the framework is trimmed; our assemblies are kept as they are). -->
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp.Views is NOT used: the view and the EGL context are ours (AndroidSkiaView). -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- Media3 (ExoPlayer) bindings; 1.11.1 targets net10.0-android36.0. Only the core module: the engine serves the stream over plain HTTP. -->
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.11.1" />
    <!-- Google Cast sender (a client of Google Play services; the binding Microsoft maintains, 122.3.1.2 targets net10.0-android36.0). Only src/PAndroid/GoogleCast touches it, and only behind AndroidCast.IsEnabled. -->
    <PackageReference Include="Xamarin.GooglePlayServices.Cast.Framework" Version="122.3.1.2" />
    <ProjectReference Include="..\AceEngine\AceEngine.csproj" />
    <ProjectReference Include="..\PUi\PUi.csproj" />
    <ProjectReference Include="..\PUi.Demo\PUi.Demo.csproj" />
    <AndroidAsset Include="..\PUi\fonts\*.ttf" Link="Assets\fonts\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\PUi\images\*.png" Link="Assets\images\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
