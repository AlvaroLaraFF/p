<Project Sdk="Microsoft.NET.Sdk">
  <!--
    P! interface drawn with SkiaSharp: screens, theme, animations, focus, key names and the common app host. No ElmSharp, Tizen or Android APIs.
    The same sources build for two targets:
      netstandard2.0 + SkiaSharp 1.60.3, REFERENCE ONLY: what PTizen uses. The TV ships its own SkiaSharp.dll 1.60 and libSkiaSharp.so and does not load another one
        (a bundled SkiaSharp does not work on it), so this target only makes the compiler reject any API newer than 1.60: PrivateAssets=all and no runtime, native or
        build assets, so no SkiaSharp file ever reaches the .tpk.
      net8.0 + SkiaSharp 2.88.9: desktop, tests and Android. The applications bring the native libraries (Linux: SkiaSharp.NativeAssets.Linux.NoDependencies; Android: its package).
    The only conditional compilation in the project is Gfx/SkiaCompat.cs (checked by a test). SkiaSharp 3.x must not be used here while the TV is a target.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>PUi</RootNamespace>
    <AssemblyName>PUi</AssemblyName>
    <NoWarn>$(NoWarn);CS0618;CS0612</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="SkiaSharp" Version="1.60.3" PrivateAssets="all" ExcludeAssets="runtime;native;build" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AceEngine\AceEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Manrope (OFL): packaged with each platform's app; kept here as the single source -->
    <None Include="fonts\*.ttf" />
    <None Include="images\*.png" />
  </ItemGroup>
</Project>
